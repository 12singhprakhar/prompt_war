# ── Application ──────────────────────────────────────────────
APP_NAME=StadiumFlow AI
DEBUG=false
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Google Services ──────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Get Maps API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# BigQuery project ID for analytics
BIGQUERY_PROJECT_ID=your-bigquery-project-id

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./stadiumflow.db

# ── Simulation ───────────────────────────────────────────────
SIMULATION_TICK_INTERVAL=2.0
MAX_VENUE_CAPACITY=132000
INITIAL_ATTENDEE_COUNT=45000
CONGESTION_THRESHOLD=0.85

# ── Security ─────────────────────────────────────────────────
# Leave empty to disable auth (development mode)
API_KEY=
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
